[Unit]
Description = User Service
[Service]
User=roboshop
Environment=MONGO=true
// highlight-start
Environment=REDIS_URL='redis://{{REDIS_HOST_NAME}}:6379'
Environment=MONGO_URL="mongodb://{{MONGODB_HOST_NAME}}:27017/users"
// highlight-end
ExecStart=/bin/node /app/server.js
SyslogIdentifier=user

[Install]
WantedBy=multi-user.target